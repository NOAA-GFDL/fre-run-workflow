#!jinja2

{# fre version should be programatically set, not hard-coded. #}
{% set FRE_VERSION = "2026.01.alpha3" %}
{% set SITE = "gaea" %}
{% set EXPERIMENT = "name" %}
{% set PROD_SEGMENT_SIMTIME = "P1Y" %}
{% set EXP_START = "1979" %}
{% set EXP_STOP = "1984" %}
{% set regression_on = False %}
{% set production_on = True %}

{# include 'platforms/platform.cylc' #}

{# Setting STALL_TIMEOUT here provides the ability to override the value if necessary #}
{# A use case for overriding this value is exhibited in the fre-workflows pipeline test_cloud_runner.yaml #}
{# In this pipeline, the stall timeout will be 0 in order for the workflow to immediately abort is stalled #}
{# This is helpful for testing pipelines; this value can be set as 'STALL_TIMEOUT="PT0S"' in the cylc play command #}
{% if STALL_TIMEOUT is not defined %}
    {% set STALL_TIMEOUT = "P1W" %}
{% endif %}

{# The combined yaml is the definitive configuration source #}
{% set YAML = EXPERIMENT + '.yaml' %}

[meta]
    title = "Production run prototype #1"
    description = """
    First draft for the production workflow definition.
    """
    URL = https://github.com/singhd789/fre-run-workflow/blob/main/README.md

[scheduler]
    UTC mode = True
    allow implicit tasks =  False
    install = etc/*, lib/*
    [[events]]
        stall timeout = {{ STALL_TIMEOUT }}
        {% if DO_WORKFLOW_EMAIL is defined and DO_WORKFLOW_EMAIL %}
            mail events = startup, shutdown, abort, stall, inactivity timeout, restart timeout
        {% endif %}

    [[mail]]
        footer = """
        Workflow: %(workflow)s
        Host: %(host)s
        """

[task parameters]

[scheduling]
    initial cycle point = {{ EXP_START }}
    final cycle point = {{ EXP_STOP }}
    [[queues]]
        [[[default]]]
            limit = 50
        [[[clean]]]
            limit = 1
            members = CLEAN
    [[graph]]
        #### OVERALL
        #setup-dirs (and error checking for listing/access to relevant configs?) =>
        #load-data (data files, gridspec cases, initcond cases, executable, data tables, diag table, field table, executable), expand-namelist? =>
        #gen-srun (mpi call; execute it and analyze results)=>
        #output-stager (submit-ascii-and-restart) =>
        #write-reload-files (reload and resubmit if needed?) =>
        #clean-tasks
        ####

        {# Setting up the directories can be done once for both the production and regression workflows #}
        R1 = """
            SETUP-DIRS:succeed-all => verify-setup => LOAD-DATA
        """

        {# REGRESSION RUN #}
        ## regression_on or production_on can be set in the [run][switches] section
        ## if R1 defined again, sections are merged not overwritten
        {% if regression_on %}
            R1 = """
                LOAD-DATA[^]:succeed-all => run-model => OUTPUT-STAGER => CLEAN
            """
        {% endif %}

        #PRODUCTION RUN
        {% if production_on %}
            R1 = """
                LOAD-DATA[^]:succeed-all => run-model
            """
        ## REPEAT EVERY SEGMENT_SIMTIME ##
            {{ PROD_SEGMENT_SIMTIME }} = """
                run-model => OUTPUT-STAGER => CLEAN

                {# if you want postprocessing done, add child tasks ...#}
                {% if pp is defined %}
                    run-model => OUTPUT-STAGER-PP => CLEAN
                {% endif %}

                # Inter-cycle dependency
                # Output of year 1 becomes input for year 2
                # run-model (ex - for year 1) will wait to start until run-model
                # for previous year finishes and outputs what it needs to
                run-model[-{{ PROD_SEGMENT_SIMTIME }}] => run-model

##after main loop
#says reload and resubmit if needed for production runs only
#something like... if there's a queue file, then source the queue file
#then look for continueflag --> if false, just exit
#if not false --> submit a script ... like this? submit -O "$nextOptions" $scriptName
#THEN CLEAN
#also after cleaning... ninac?
#################
            """
        {% endif %}

#####
#THINGS TO THINK ABOUT:
# - everything that needs to be cleaned
# - better ensemble support
# - easibility to create YAML configs
#####
[runtime]
    [[root]]
        [[[environment]]]
            fre_yaml = $CYLC_WORKFLOW_RUN_DIR/{{ YAML }}

    [[SETUP-DIRS]]
    [[setup-workdir]]
        inherit = SETUP-DIRS
    [[setup-statedir]]
        inherit = SETUP-DIRS
    [[setup-ptmpdir]]
        inherit = SETUP-DIRS

    [[verify-setup]]

    [[LOAD-DATA]]
    [[load-diagtable]]
        inherit = LOAD-DATA
    [[load-datatable]]
        inherit = LOAD-DATA
    [[load-fieldtable]]
        inherit = LOAD-DATA
    [[load-datafiles]]
        inherit = LOAD-DATA
    [[load-executable]]
        inherit = LOAD-DATA
    [[expand-namelists]]
        inherit = LOAD-DATA

    [[run-model]]

    [[OUTPUT-STAGER]]

    [[CLEAN]]

        
